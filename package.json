{
  "name": "cossack",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode production && vite build --mode ssr --ssr",
    "preview": "$npm_execpath run build && vite preview",
    "dev:wrangler": "pnpm run build && wrangler dev",
    "deploy": "$npm_execpath run build && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "test": "vitest"
  },
  "dependencies": {
    "@cossackframework/renderer": "link:../../.local/share/pnpm/global/5/node_modules/@cossackframework/renderer",
    "hono": "^4.9.5",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.11.17",
    "jsdom": "^24.0.0",
    "vite": "^6.3.5",
    "vitest": "^1.2.2",
    "wrangler": "^4.17.0"
  }
}