{
  "name": "@cossackframework/desktop",
  "version": "0.9.0",
  "type": "module",
  "description": "Secure Electron desktop runtime for Cossack applications",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cossackframework/cossack",
    "directory": "packages/desktop"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "cossack-desktop": "./dist/dev.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.declarations.json && chmod +x dist/dev.js",
    "test": "vitest --run"
  },
  "dependencies": {
    "@cossackframework/core": "workspace:*"
  },
  "peerDependencies": {
    "electron": "^43.7.0 || >=44.4.0",
    "vite": "^8.1.4"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "electron": "^43.7.0",
    "image-size": "^2.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.11"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
