{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@cossackframework/renderer": ["../../../src/index.ts"],
      "@cossackframework/renderer/*": ["../../../src/*.ts"]
    }
  },
  "include": ["*.ts", "defects/*.ts"]
}
