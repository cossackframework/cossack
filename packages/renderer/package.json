    "magic-string": "^0.30.21",
    "oxlint": "^1.41.0",
    "vite": "^8.1.0",
    "vite-plugin-dts": "^3.9.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.9"
  }
}
