{
  "name": "@cossackframework/renderer",
  "version": "0.5.1",
  "type": "module",
  "description": "Light DOM rendering engine for the Cossack Framework",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cossackframework/cossack",
    "directory": "packages/renderer"
  },
  "main": "./dist/index.js",
