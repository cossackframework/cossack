{
  "name": "@cossackframework/renderer",
  "version": "0.9.0",
  "type": "module",
  "sideEffects": false,
  "description": "The rendering engine for Cossack Framework. Lit inspired, light dom, ssr",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cossackframework/cossack",
    "directory": "packages/renderer"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "agent-docs.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "workerd": "./dist/index.js",
      "worker": "./dist/index.js",
      "node": "./dist/index.js",
      "browser": "./dist/browser.js",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./attributes": {
      "types": "./dist/attributes.d.ts",
      "import": "./dist/attributes.js"
    },
    "./template": {
      "types": "./dist/template.d.ts",
      "import": "./dist/template.js"
    },
    "./diagnostics": {
      "types": "./dist/diagnostics.d.ts",
      "import": "./dist/diagnostics.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.declarations.json && node ../../scripts/rewrite-declaration-imports.mjs dist",
    "test": "vitest",
    "lint": "oxlint"
  },
  "dependencies": {
    "css-tree": "^3.2.1",
    "parse5": "8.0.1"
  },
  "devDependencies": {
    "happy-dom": "^21.0.4",
    "oxlint": "^1.41.0",
    "source-map-js": "^1.2.2",
    "typescript": "^7.0.2",
    "typescript-api": "npm:typescript@6.0.3",
    "vite": "^8.1.6",
    "vitest": "^4.1.12"
  }
}
