{
  "name": "@cossackframework/cms",
  "version": "0.9.0",
  "type": "module",
  "description": "Cossack CMS: resources, schema planning, repositories, auth and stores on RomeDB",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cossackframework/cossack",
    "directory": "packages/cms"
  },
  "main": "src/index.ts",
  "files": [
    "src",
    "app",
    "!app/src/plugins/example",
    "agent-docs.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "pnpm --dir app run dev",
    "sync": "pnpm --dir app run sync",
    "brands": "node scripts/brand-icons.mjs",
    "test": "pnpm sync && vitest",
    "icons": "node scripts/icon-catalog.mjs"
  },
  "dependencies": {
    "@cossackframework/auth": "workspace:*",
    "@cossackframework/core": "workspace:*",
    "@cossackframework/renderer": "workspace:*",
    "@cossackframework/romedb": "workspace:*",
    "markdown-it": "15.0.3",
    "@cossackframework/solar-icons": "0.7.1"
  },
  "peerDependencies": {
    "hono": "^4.13.7",
    "vite": "*"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.19.0",
    "hono": "^4.13.7",
    "miniflare": "4.20260722.0",
    "rolldown": "~1.1.5",
    "simple-icons": "16.36.0",
    "vitest": "^4.1.12",
    "vite": "^8.1.6"
  },
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server/index.ts",
    "./isolate": "./src/isolate.ts",
    "./cloudflare": "./src/cloudflare.ts",
    "./vite": {
      "types": "./src/vite.d.ts",
      "default": "./src/vite.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
