{
  "name": "@cossackframework/cms",
  "version": "0.9.3",
  "type": "module",
  "description": "Cossack CMS: resources, schema planning, repositories, auth and stores on RomeDB",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cossackframework/cossack",
    "directory": "packages/cms"
  },
  "main": "src/index.ts",
  "files": [
    "src",
    "app",
    "!app/src/plugins/example",
    "agent-docs.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "pnpm --dir app run dev",
    "sync": "pnpm --dir app run sync",
    "brands": "node scripts/brand-icons.mjs",
    "test": "pnpm sync && vitest",
    "icons": "node scripts/icon-catalog.mjs",
    "prepack": "pnpm sync"
  },
  "dependencies": {
    "@cossackframework/auth": "workspace:*",
    "@cossackframework/core": "workspace:*",
    "@cossackframework/database": "workspace:*",
    "@cossackframework/renderer": "workspace:*",
    "@cossackframework/romedb": "workspace:*",
    "@cossackframework/solar-icons": "0.7.1",
    "@simplewebauthn/browser": "14.0.0",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-document": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/extension-text-align": "3.32.0",
    "@tiptap/extensions": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "markdown-it": "15.0.3",
    "prosemirror-collab": "1.3.1",
    "uqr": "0.1.3"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@cossackframework/framework": "workspace:*",
    "@cossackframework/node-adapter": "workspace:*",
    "@cossackframework/ui": "workspace:*",
    "hono": "^4.13.18",
    "sharp": "^0.35.5",
    "vite": "*"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@cossackframework/framework": "workspace:*",
    "@cossackframework/node-adapter": "workspace:*",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.19.0",
    "hono": "^4.13.18",
    "miniflare": "4.20260722.0",
    "rolldown": "~1.1.5",
    "sharp": "^0.35.5",
    "simple-icons": "16.36.0",
    "vite": "^8.1.6",
    "vitest": "^4.1.12"
  },
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server/index.ts",
    "./updates": "./src/updates.ts",
    "./isolate": "./src/isolate.ts",
    "./cloudflare": "./src/cloudflare.ts",
    "./node": "./src/node.ts",
    "./storage": "./src/storage/index.ts",
    "./storage/cloudflare": "./src/storage/cloudflare.ts",
    "./storage/node": "./src/storage/node.ts",
    "./vite": {
      "types": "./src/vite.d.ts",
      "default": "./src/vite.js"
    },
    "./app/*": "./app/src/*.ts",
    "./app/cms/blocks.css": "./app/src/cms/blocks.css",
    "./package.json": "./package.json"
  },
  "imports": {
    "#app/*": "./app/src/*.ts"
  },
  "cossack": {
    "vite": "src/vite.js",
    "root": "app/src",
    "alias": "cms",
    "pages": [
      "pages/"
    ],
    "plugins": [
      "plugins/default-theme/"
    ],
    "config": [
      "config/cms.ts",
      "config/auth.ts"
    ],
    "host": [
      "cms.config.ts",
      "stores.client.ts",
      "orm/factory.ts",
      "models/User.ts",
      "models/Session.ts",
      "models/Role.ts",
      "models/UserRole.ts",
      "models/OAuthAccount.ts",
      "models/UserSecurity.ts",
      "models/Passkey.ts",
      "models/AuthChallenge.ts",
      "models/AuthAttempt.ts",
      "models/ApiToken.ts",
      "models/Tenant.ts",
      "models/TenantDomain.ts",
      "models/TenantMember.ts",
      "models/TenantHandoff.ts",
      "models/TenantNetwork.ts",
      "models/TenantSession.ts"
    ],
    "hostTemplate": "0.9.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@cossackframework/node-adapter": {
      "optional": true
    },
    "sharp": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  }
}
