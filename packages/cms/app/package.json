{
  "name": "@cossackframework/cms-app",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "description": "The Cossack CMS as an application: the source of the files `cossack add cms` renders, run from the workspace",
  "cossack": {
    "runtime": "node"
  },
  "scripts": {
    "sync": "node scripts/sync.mjs",
    "dev": "node scripts/start.mjs",
    "build": "node scripts/sync.mjs && vite build && vite build --ssr src/index.ts --outDir dist/server",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "typecheck": "node scripts/sync.mjs && cossack routes --generate && tsc --noEmit"
  },
  "devDependencies": {
    "@cossackframework/typescript-plugin": "workspace:*",
    "@types/node": "^22.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "prettier": "^3.4.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vite": "~8.1.6",
    "vitest": "^4.1.12",
    "@types/mdast": "^4.0.4",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-sugar-high": "^0.6.3",
    "remark-toc": "^9.0.0",
    "unified": "^11.0.5",
    "vfile-matter": "^5.0.1",
    "@types/ws": "^8.18.0",
    "@cossackframework/scaffold": "workspace:*"
  },
  "dependencies": {
    "@cossackframework/core": "workspace:*",
    "@cossackframework/framework": "workspace:*",
    "@cossackframework/renderer": "workspace:*",
    "cossack": "workspace:*",
    "hono": "^4.13.7",
    "@cossackframework/ui": "workspace:*",
    "@cossackframework/solar-icons": "0.7.1",
    "@cossackframework/cms": "workspace:*",
    "@cossackframework/romedb": "workspace:*",
    "@cossackframework/auth": "workspace:*",
    "@tiptap/core": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@tiptap/extension-document": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/extension-text-align": "3.32.0",
    "@tiptap/extensions": "3.32.0",
    "prosemirror-collab": "1.3.1",
    "@aws-sdk/client-s3": "^3.1156.0",
    "sharp": "^0.35.5",
    "@romedb/client": "0.2.21",
    "@romedb/node": "0.2.21",
    "@simplewebauthn/browser": "14.0.0",
    "uqr": "0.1.3",
    "@cossackframework/node-adapter": "workspace:*",
    "@hono/node-server": "^2.1.6",
    "ws": "^8.18.0"
  }
}
