# Only the CMS sources named in cossack-recipe.json are tracked. The rest of this
# application (the shared shell) is rendered by `pnpm sync` from packages/scaffold/template.
/*
!/.gitignore
!/README.md
!/package.json
!/cossack-recipe.json
!/scripts/
/scripts/*
!/scripts/sync.mjs
!/scripts/romedb.sh
!/scripts/start.mjs
!/src/
/src/*
!/src/auth.ts
!/src/brand.ts
!/src/passkeys.client.ts
!/src/cms/
# Rendered per runtime adapter by the recipe.
/src/cms/media.ts
/src/cms/pending.ts
!/src/config/
/src/config/*
!/src/config/cms.ts
!/src/dashboard/
/src/dashboard/*
!/src/dashboard/access.ts
!/src/dashboard/user-sections.ts
!/src/lib/
/src/lib/*
!/src/lib/permissions.ts
!/src/services/
/src/services/*
!/src/services/rbac.ts
!/src/services/roles.ts
!/src/services/users.ts
!/src/plugins/
/src/plugins/*
!/src/plugins/default-theme/
!/src/pages/
/src/pages/*
!/src/pages/(site)/
!/src/pages/api/
/src/pages/api/*
!/src/pages/api/auth/
!/src/pages/api/cms/
!/src/pages/auth/
/src/pages/auth/*
!/src/pages/auth/setup/
!/src/pages/dashboard/
/src/pages/dashboard/*
!/src/pages/dashboard/(cms)/
!/src/pages/dashboard/index.ts
