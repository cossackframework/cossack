# Only CMS sources named in cossack-recipe.json and application tests are tracked. The rest of this
# application is written by `pnpm sync`: the shared shell from packages/dashboard/app/src, the
# project files from the scaffold.
/*
!/.gitignore
!/README.md
!/package.json
!/cossack-recipe.json
!/.npmignore
!/scripts/
!/tests/
/scripts/*
!/scripts/sync.mjs
!/scripts/start.mjs
!/src/
/src/*
!/src/mail.ts
!/src/avatars.ts
!/src/auth-events.ts
!/src/auth-options.ts
!/src/brand.ts
!/src/passkeys.client.ts
!/src/cms/
!/src/config/
/src/config/*
!/src/config/cms.ts
!/src/dashboard/
/src/dashboard/*
!/src/dashboard/access.ts
!/src/dashboard/icons.ts
!/src/dashboard/head.ts
!/src/dashboard/user-sections.ts
!/src/lib/
/src/lib/*
!/src/lib/permissions.ts
!/src/services/
/src/services/*
!/src/services/rbac.ts
!/src/plugins/
/src/plugins/*
!/src/plugins/default-theme/
# The example plugin is tracked for development; cossack-recipe.json does not list it, and the package leaves it out.
!/src/plugins/example/
!/src/pages/
/src/pages/*
!/src/pages/(site)/
!/src/pages/api/
/src/pages/api/*
!/src/pages/api/auth/
!/src/pages/api/cms/
!/src/pages/auth/
/src/pages/auth/*
!/src/pages/auth/setup/
!/src/pages/auth/register-site/
!/src/pages/dashboard/
/src/pages/dashboard/*
!/src/pages/dashboard/(cms)/
!/src/pages/dashboard/index.ts
