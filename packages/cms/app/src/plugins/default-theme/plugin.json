{
  "schemaVersion": 1,
  "name": "default-theme",
  "version": "1.0.0",
  "description": "The default site theme of the Cossack CMS. Edit it, or copy it to start your own theme.",
  "compatibility": {
    "@cossackframework/cms": ">=0.9.0"
  },
  "logo": "assets/logo.svg",
  "cover": "assets/cover.svg",
  "fieldGroups": [
    {
      "id": "default-theme-menu",
      "title": "Menu item details",
      "description": "Shown with the link in a mega menu panel.",
      "targets": [
        {
          "kind": "menus"
        }
      ],
      "blocks": [
        {
          "_id": "icon",
          "type": "field/media",
          "data": {
            "name": "icon",
            "label": "Icon",
            "description": "A small image or SVG from the library, shown before the link."
          }
        },
        {
          "_id": "badge",
          "type": "field/text",
          "data": {
            "name": "badge",
            "label": "Badge",
            "max": 20,
            "description": "A short word after the link, such as New."
          }
        }
      ]
    }
  ],
  "theme": {
    "label": "Cossack Default",
    "description": "A clean, readable theme: a header and footer built from blocks, a menu with dropdowns and mega panels, search and an accent color.",
    "locations": {
      "primary": "Primary menu",
      "mobile": "Mobile menu",
      "footer": "Footer menu"
    },
    "areas": {
      "header": {
        "label": "Header",
        "blocks": [
          {
            "_id": "header-row",
            "type": "core/group",
            "data": {
              "align": "full",
              "direction": "row",
              "justify": "between"
            },
            "children": [
              {
                "_id": "header-logo",
                "type": "core/site-logo",
                "data": {
                  "showTagline": true
                }
              },
              {
                "_id": "header-tools",
                "type": "core/group",
                "data": {
                  "direction": "row",
                  "justify": "end"
                },
                "children": [
                  {
                    "_id": "header-menu",
                    "type": "core/navigation",
                    "data": {
                      "location": "primary",
                      "style": "dropdowns",
                      "mobile": "mobile"
                    }
                  },
                  {
                    "_id": "header-search",
                    "type": "core/search",
                    "data": {},
                    "layout": {
                      "hide": [
                        "sm"
                      ]
                    }
                  },
                  {
                    "_id": "header-languages",
                    "type": "core/languages",
                    "data": {}
                  }
                ]
              }
            ],
            "style": {
              "padding": "medium"
            }
          }
        ]
      },
      "footer": "Footer widgets",
      "footer-bar": {
        "label": "Footer bar",
        "blocks": [
          {
            "_id": "footer-row",
            "type": "core/group",
            "data": {
              "align": "full",
              "direction": "row",
              "justify": "between"
            },
            "children": [
              {
                "_id": "footer-menu",
                "type": "core/navigation",
                "data": {
                  "location": "footer",
                  "style": "inline"
                }
              },
              {
                "_id": "footer-languages",
                "type": "core/languages",
                "data": {}
              },
              {
                "_id": "footer-text",
                "type": "core/paragraph",
                "data": {
                  "text": "© {{ $site.year }} {{ $site.title }} · [RSS](/feed) · [Log in](/auth/login)"
                }
              }
            ],
            "style": {
              "padding": "medium"
            }
          }
        ]
      }
    },
    "presets": {
      "colors": [
        {
          "slug": "base",
          "name": "Base",
          "value": "#ffffff"
        },
        {
          "slug": "contrast",
          "name": "Contrast",
          "value": "#111827"
        },
        {
          "slug": "primary",
          "name": "Primary",
          "value": "#2563eb"
        },
        {
          "slug": "secondary",
          "name": "Secondary",
          "value": "#f1f5f9"
        },
        {
          "slug": "accent",
          "name": "Accent",
          "value": "#f59e0b"
        },
        {
          "slug": "muted",
          "name": "Muted",
          "value": "#64748b"
        }
      ]
    },
    "options": {
      "accent": {
        "kind": "enum",
        "values": [
          "neutral",
          "blue",
          "emerald",
          "violet",
          "rose",
          "amber"
        ],
        "default": "neutral",
        "label": "Accent color",
        "choices": {
          "neutral": "Neutral",
          "blue": "Blue",
          "emerald": "Emerald",
          "violet": "Violet",
          "rose": "Rose",
          "amber": "Amber"
        }
      },
      "width": {
        "kind": "enum",
        "values": [
          "narrow",
          "wide"
        ],
        "default": "narrow",
        "label": "Content width",
        "choices": {
          "narrow": "Narrow, best for reading",
          "wide": "Wide"
        }
      },
      "fontFamily": {
        "kind": "enum",
        "values": [
          "sans",
          "humanist",
          "serif",
          "mono"
        ],
        "default": "sans",
        "label": "Font",
        "description": "System fonts: nothing to download.",
        "choices": {
          "sans": "Sans-serif",
          "humanist": "Humanist sans-serif",
          "serif": "Serif",
          "mono": "Monospace"
        }
      },
      "baseSize": {
        "kind": "enum",
        "values": [
          "small",
          "medium",
          "large"
        ],
        "default": "medium",
        "label": "Text size",
        "choices": {
          "small": "Small (15px)",
          "medium": "Medium (16px)",
          "large": "Large (18px)"
        }
      },
      "headingWeight": {
        "kind": "enum",
        "values": [
          "normal",
          "medium",
          "semibold",
          "bold"
        ],
        "default": "bold",
        "label": "Heading weight",
        "choices": {
          "normal": "Normal",
          "medium": "Medium",
          "semibold": "Semibold",
          "bold": "Bold"
        }
      }
    }
  }
}
