{
  "schemaVersion": 1,
  "name": "default-theme",
  "version": "1.0.0",
  "description": "The default site theme of the Cossack CMS. Edit it, or copy it to start your own theme.",
  "compatibility": {
    "@cossackframework/cms": ">=0.9.0"
  },
  "logo": "assets/logo.svg",
  "cover": "assets/cover.svg",
  "theme": {
    "label": "Cossack Default",
    "description": "A clean, readable theme: a header menu with dropdowns, a footer menu, search and an accent colour.",
    "locations": {
      "primary": "Primary menu",
      "footer": "Footer menu"
    },
    "options": {
      "accent": {
        "kind": "enum",
        "values": [
          "neutral",
          "blue",
          "emerald",
          "violet",
          "rose",
          "amber"
        ],
        "default": "neutral",
        "label": "Accent colour",
        "choices": {
          "neutral": "Neutral",
          "blue": "Blue",
          "emerald": "Emerald",
          "violet": "Violet",
          "rose": "Rose",
          "amber": "Amber"
        }
      },
      "width": {
        "kind": "enum",
        "values": [
          "narrow",
          "wide"
        ],
        "default": "narrow",
        "label": "Content width",
        "choices": {
          "narrow": "Narrow, best for reading",
          "wide": "Wide"
        }
      },
      "showSearch": {
        "kind": "boolean",
        "default": true,
        "label": "Show a search box in the header"
      },
      "footerText": {
        "kind": "string",
        "max": 200,
        "default": "",
        "label": "Footer text",
        "description": "Shown instead of the copyright line when set."
      }
    }
  }
}
