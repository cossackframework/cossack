{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "my-cossack-app",
  "compatibility_flags": [
    "nodejs_compat",
    "enable_request_signal"
  ],
  "compatibility_date": "2026-06-06",
  "main": "./src/index.ts",
  // Cloudflare Email Routing. Used by binding('EMAIL').send(...) for password
  // reset (and any transactional email). Verify the `from` domain in the
  // dashboard; until then requestPasswordReset is a graceful no-op.
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  // Wrangler provisions D1 on deployment when database_id is omitted.
  // Local development uses a local database. Apply migrations explicitly.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "app-db",
      "preview_database_id": "app-local"
    }
  ],
  // Distributed SSE coordination for `@Page({ transport: 'sse' })` pages.
  // SseDurableObject is SQLite-backed: add new_sqlite_classes (not new_classes).
  "durable_objects": {
    "bindings": [
      {
        "name": "COSSACK_SSE",
        "class_name": "SseDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "SseDurableObject"
      ]
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // Replace with your production domain. Used for sitemap generation, canonical
  // URLs, and OG tags. Also exposed to the Worker at runtime as env.APP_URL
  // (read via config('app.url')).
  //
  // APP_LOCALE sets the default locale for `__()`. See `cossack lang publish`.
  // APP_SECRET signs flash-data cookies. Set it with wrangler secret put.
  "secrets": { "required": ["APP_SECRET"] },
  "vars": {
    "APP_URL": "https://example.com",
    "APP_LOCALE": "en",
    "CORS_ENABLED": "true",
    "CORS_ORIGINS": "",
    "CORS_METHODS": "GET,HEAD,POST,PUT,PATCH,DELETE,OPTIONS",
    "CORS_HEADERS": "",
    "CORS_EXPOSE_HEADERS": "",
    "CORS_CREDENTIALS": "false",
    "CORS_MAX_AGE": "86400"
  }
}
