{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "my-cossack-app",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "compatibility_date": "2026-06-06",
  "main": "./src/index.ts",
  // Cloudflare Email Routing. Used by binding('EMAIL').send(...) for password
  // reset (and any transactional email). Verify the `from` domain in the
  // dashboard; until then requestPasswordReset is a graceful no-op.
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  // Cloudflare D1 binding. Replace <database_id> with the output of
  // `npx wrangler d1 create <name>`, then run `cossack migration up`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "app-db",
      "database_id": "<database_id>"
    }
  ],
  // "durable_objects": {
  //   "bindings": [
  //     {
  //       "name": "COSSACK_OBJECT",
  //       "class_name": "AppDurableObject"
  //     }
  //   ]
  // },
  // "migrations": [
  //   {
  //     "tag": "v1",
  //     "new_classes": [
  //       "AppDurableObject"
  //     ]
  //   }
  // ],
  "assets": {
    "binding": "ASSETS"
  },
  // Replace with your production domain. Used for sitemap generation, canonical
  // URLs, and OG tags. Also exposed to the Worker at runtime as env.APP_URL
  // (read via config('app.url')).
  //
  // APP_LOCALE sets the default locale for `__()`. See `cossack lang publish`.
  // APP_SECRET signs flash-data cookies (min 16 chars); set a real secret.
  "vars": {
    "APP_URL": "https://example.com",
    "APP_LOCALE": "en",
    "APP_SECRET": "PLEASE_CHANGE_THIS_SECRET",
    "CORS_ENABLED": "true",
    "CORS_ORIGINS": "",
    "CORS_METHODS": "GET,HEAD,POST,PUT,PATCH,DELETE,OPTIONS",
    "CORS_HEADERS": "",
    "CORS_EXPOSE_HEADERS": "",
    "CORS_CREDENTIALS": "false",
    "CORS_MAX_AGE": "86400"
  }
}
