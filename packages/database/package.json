{
  "name": "@cossackframework/database",
  "version": "0.8.2",
  "description": "Serverless-first Active Record ORM for Cossack",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cossackframework/cossack",
    "directory": "packages/database"
  },
  "homepage": "https://github.com/cossackframework/cossack/tree/main/packages/database#readme",
  "bugs": {
    "url": "https://github.com/cossackframework/cossack/issues"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "cossack-orm": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapter": {
      "types": "./dist/adapter/index.d.ts",
      "import": "./dist/adapter/index.js"
    },
    "./node": {
      "types": "./dist/runtime/node.d.ts",
      "import": "./dist/runtime/node.js"
    },
    "./bun": {
      "types": "./dist/runtime/bun.d.ts",
      "import": "./dist/runtime/bun.js"
    },
    "./cloudflare": {
      "types": "./dist/runtime/cloudflare.d.ts",
      "import": "./dist/runtime/cloudflare.js"
    },
    "./deno": {
      "types": "./dist/runtime/deno.d.ts",
      "import": "./dist/runtime/deno.js"
    },
    "./cossack": {
      "types": "./dist/cossack/index.d.ts",
      "import": "./dist/cossack/index.js"
    },
    "./tooling": {
      "types": "./dist/tooling/index.d.ts",
      "import": "./dist/tooling/index.js"
    },
    "./cli": "./dist/cli.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:bundle": "node scripts/audit-bundles.mjs",
    "example:sqlite": "tsx ./examples/sqlite-starter/run.ts",
    "example:sqlite:reset": "tsx ./examples/sqlite-starter/run.ts --reset",
    "example:sqlite:create": "tsx ./examples/sqlite-starter/create-database.ts",
    "example:sqlite:migrate": "tsx ./examples/sqlite-starter/migrate.ts",
    "example:sqlite:seed": "tsx ./examples/sqlite-starter/seed.ts",
    "example:sqlite:query": "tsx ./examples/sqlite-starter/query.ts",
    "example:multiple-connections": "tsx ./examples/multiple-connections/run.ts",
    "example:multiple-connections:reset": "tsx ./examples/multiple-connections/run.ts --reset",
    "prepack": "pnpm build && pnpm test && pnpm audit:bundle"
  },
  "dependencies": {
    "tsx": "^4.23.0"
  },
  "peerDependencies": {
    "@tursodatabase/database": "^0.7.2",
    "@tursodatabase/serverless": "^1.4.0",
    "better-sqlite3": ">=11",
    "hono": "^4.12.34",
    "mysql2": ">=3.11",
    "pg": ">=8.13",
    "reflect-metadata": ">=0.2"
  },
  "peerDependenciesMeta": {
    "@tursodatabase/database": {
      "optional": true
    },
    "@tursodatabase/serverless": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "reflect-metadata": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "hono": "^4.12.34",
    "reflect-metadata": "^0.2.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
