{
  "name": "@cossackframework/ui",
  "version": "0.8.0",
  "type": "module",
  "sideEffects": false,
  "description": "UI component library for the Cossack Framework — token-driven, themeable components and Solar icons",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cossackframework/cossack",
    "directory": "packages/ui"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./blocks": {
      "types": "./dist/blocks/index.d.ts",
      "import": "./dist/blocks/index.js"
    },
    "./theme/base.css": "./src/theme/base.css",
    "./theme/theme.css": "./src/theme/theme.css",
    "./theme/themes/default.css": "./src/theme/themes/default.css",
    "./theme/themes/dark.css": "./src/theme/themes/dark.css",
    "./theme/themes/neutral.css": "./src/theme/themes/neutral.css",
    "./theme/themes/zinc.css": "./src/theme/themes/zinc.css",
    "./theme/themes/stone.css": "./src/theme/themes/stone.css",
    "./theme/themes/gray.css": "./src/theme/themes/gray.css",
    "./theme/themes/slate.css": "./src/theme/themes/slate.css",
    "./theme/themes/blue.css": "./src/theme/themes/blue.css",
    "./theme/themes/green.css": "./src/theme/themes/green.css",
    "./theme/themes/red.css": "./src/theme/themes/red.css"
  },
  "files": [
    "dist",
    "src/blocks",
    "src/components",
    "src/theme"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.declarations.json",
    "prepublishOnly": "pnpm run build",
    "pretest": "pnpm run build",
    "test": "vitest",
    "build:icons": "tsx src/scripts/build-icons.ts"
  },
  "peerDependencies": {
    "@cossackframework/core": "^0.8.0",
    "@cossackframework/solar-icons": "^0.7.1",
    "@cossackframework/renderer": "^0.8.0"
  },
  "devDependencies": {
    "@cossackframework/core": "workspace:*",
    "@cossackframework/solar-icons": "^0.7.1",
    "@cossackframework/renderer": "workspace:*",
    "@types/node": "^22.19.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
