{
  "name": "@cossackframework/ui",
  "version": "0.9.0",
  "type": "module",
  "sideEffects": false,
  "description": "UI component library for the Cossack Framework — token-driven, themeable components and Solar icons",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cossackframework/cossack",
    "directory": "packages/ui"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./blocks": {
      "types": "./dist/blocks/index.d.ts",
      "import": "./dist/blocks/index.js"
    },
    "./theme/base.css": "./src/theme/base.css",
    "./theme/theme.css": "./src/theme/theme.css",
    "./theme/themes/default.css": "./src/theme/themes/default.css",
    "./theme/themes/dark.css": "./src/theme/themes/dark.css",
    "./theme/themes/neutral.css": "./src/theme/themes/neutral.css",
    "./theme/themes/zinc.css": "./src/theme/themes/zinc.css",
    "./theme/themes/stone.css": "./src/theme/themes/stone.css",
    "./theme/themes/gray.css": "./src/theme/themes/gray.css",
    "./theme/themes/slate.css": "./src/theme/themes/slate.css",
    "./theme/themes/blue.css": "./src/theme/themes/blue.css",
    "./theme/themes/green.css": "./src/theme/themes/green.css",
    "./theme/themes/red.css": "./src/theme/themes/red.css"
  },
  "files": [
    "dist",
    "src/blocks",
    "src/components",
    "src/internal",
    "src/theme",
    "agent-docs.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.declarations.json && node ../../scripts/rewrite-declaration-imports.mjs dist",
    "prepublishOnly": "pnpm run build",
    "pretest": "pnpm run build",
    "test": "vitest",
    "pretest:browser": "pnpm run build",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "build:icons": "tsx src/scripts/build-icons.ts"
  },
  "peerDependencies": {
    "@cossackframework/core": "^0.9.0",
    "@cossackframework/renderer": "^0.9.0",
    "@cossackframework/solar-icons": "^0.7.1"
  },
  "devDependencies": {
    "@cossackframework/core": "workspace:*",
    "@cossackframework/renderer": "workspace:*",
    "@cossackframework/solar-icons": "^0.7.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.19.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/merge": "^6.12.3",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "codemirror": "^6.0.2",
    "codemirror-json-schema": "0.8.1"
  }
}
