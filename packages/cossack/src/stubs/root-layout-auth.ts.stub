import { Cossack, Page } from '@cossackframework/core';
import { html } from '@cossackframework/renderer';

@Page({ transport: 'http' })
export default class RootLayout extends Cossack {
  render() {
    return html`
      <div class="min-h-screen">
        ${this.children}
      </div>
    `;
  }
}
