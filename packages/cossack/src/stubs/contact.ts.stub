import { __, Client, ClientState, ClientStore, Cossack, Page, Server, Validate, storeRules, validateObject } from '@cossackframework/core';
import { Button, Field, Input, Textarea } from '@cossackframework/ui';
import { component, html } from '@cossackframework/renderer';
interface ContactPayload { name: string; email: string; message: string; }
const contactRules = storeRules<ContactPayload>({ name: { required: true, minLength: 2, message: 'Please enter your name' }, email: { required: true, email: true, message: 'Please enter a valid email address' }, message: { required: true, minLength: 10, message: 'Message must be at least 10 characters' } });
@Page({ transport: 'http' })
export default class ContactPage extends Cossack {
    @ClientStore()
    @Validate({ rules: contactRules, config: { trigger: 'all', runOn: 'client' } })
    form: ContactPayload = { name: '', email: '', message: '' };
    @ClientStore() errors: Record<string, string> = {};
    @ClientState() success = '';
    @ClientState() error = '';
    @Client() handleInput(field: keyof ContactPayload, event: Event) { this.form[field] = (event.target as HTMLInputElement | HTMLTextAreaElement).value; this.validateProperty(`form.${field}`, 'input'); }
    @Client() handleBlur(field: keyof ContactPayload) { this.validateProperty(`form.${field}`, 'blur'); }
    @Client() async handleSubmit(event: Event) { event.preventDefault(); this.success = ''; this.error = ''; if (!(await this.validateAll())) return; try { await this.submitContact({ ...this.form }); this.form = { name: '', email: '', message: '' }; this.clearErrors(); this.success = __('Thanks! Your message was received.'); } catch (error) { this.error = error instanceof Error ? error.message : __('Unable to send your message.'); } }
    @Server() async submitContact(payload: ContactPayload): Promise<{ success: true }> { const { valid } = await validateObject(payload, contactRules); if (!valid) throw new Error('Please check your contact details and try again.'); console.info('contact.submitted', payload); return { success: true }; }
    render() {
        const field = (name: keyof ContactPayload) => `form.${name}`;
        return html`<section class="mx-auto max-w-xl px-4 py-16"><h1 class="text-4xl font-bold">${__('Contact')}</h1>${this.success ? html`<p role="status">${this.success}</p>` : ''}${this.error ? html`<p role="alert">${this.error}</p>` : ''}<form @submit=${this.handleSubmit} class="mt-8 space-y-5" novalidate>${component(Field, { label: __('Name'), for: 'name', required: true, error: this.getError(field('name')) }, component(Input, { id: 'name', required: true, '.value': this.form.name, '@input': (event: Event) => this.handleInput('name', event), '@blur': () => this.handleBlur('name'), variant: this.hasError(field('name')) ? 'error' : 'default' }))}${component(Field, { label: __('Email'), for: 'email', required: true, error: this.getError(field('email')) }, component(Input, { id: 'email', type: 'email', required: true, '.value': this.form.email, '@input': (event: Event) => this.handleInput('email', event), '@blur': () => this.handleBlur('email'), variant: this.hasError(field('email')) ? 'error' : 'default' }))}${component(Field, { label: __('Message'), for: 'message', required: true, error: this.getError(field('message')) }, component(Textarea, { id: 'message', required: true, rows: 6, '.value': this.form.message, '@input': (event: Event) => this.handleInput('message', event), '@blur': () => this.handleBlur('message'), variant: this.hasError(field('message')) ? 'error' : 'default' }))}${component(Button, { type: 'submit', disabled: this.loading.submitContact }, this.loading.submitContact ? __('Sending…') : __('Send message'))}</form></section>`;
    }
}
