{
  "name": "cossack",
  "version": "0.9.0",
  "type": "module",
  "description": "The Cossack Framework CLI \u2014 scaffolding, code generation, lifecycle, and upgrades for Cossack projects.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cossackframework/cossack",
    "directory": "packages/cossack"
  },
  "bin": {
    "cossack": "./bin/cossack.js",
    "cossack-mcp": "./bin/cossack-mcp.js"
  },
  "files": [
    "bin",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "node ./bin/cossack.js",
    "test": "vitest --run --project unit",
    "test:integration": "vitest --run --project integration"
  },
  "dependencies": {
    "@cossackframework/core": "workspace:*",
    "@cossackframework/framework": "workspace:*",
    "@cossackframework/renderer": "workspace:*",
    "@cossackframework/scaffold": "workspace:*",
    "@modelcontextprotocol/server": "^2.3.0",
    "prompts": "^2.4.2",
    "tsx": "^4.23.0",
    "typescript-api": "npm:typescript@6.0.3",
    "vite": "^8.1.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@jridgewell/trace-mapping": "0.3.31",
    "@modelcontextprotocol/client": "^2.3.0",
    "@playwright/test": "^1.61.1",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "./vitest-reporter": {
      "types": "./src/vitest-reporter.d.ts",
      "import": "./src/vitest-reporter.js"
    },
    "./package.json": "./package.json",
    "./src/*": "./src/*",
    "./bin/*": "./bin/*"
  }
}
