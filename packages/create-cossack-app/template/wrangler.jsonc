{
  "$schema": "https://schema.cloudflare.com/workers-wrangler-v3.json",
  "name": "my-cossack-app",
  "compatibility_date": "2024-01-01",
  "main": "dist/worker/index.js",
  "durable_objects": {
    "bindings": [
      {
        "name": "COSSACK_OBJECT",
        "class_name": "AppDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": [
        "AppDurableObject"
      ]
    }
  ],
  "build": {
    "command": "vite build && vite build --ssr",
    "watch_dir": "src"
  },
  "assets": {
    "directory": "./dist/client"
  }
}