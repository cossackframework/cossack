{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "my-cossack-app",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "compatibility_date": "2026-06-06",
  "main": "./src/index.ts",
  // "durable_objects": {
  //   "bindings": [
  //     {
  //       "name": "COSSACK_OBJECT",
  //       "class_name": "AppDurableObject"
  //     }
  //   ]
  // },
  // "migrations": [
  //   {
  //     "tag": "v1",
  //     "new_classes": [
  //       "AppDurableObject"
  //     ]
  //   }
  // ],
  "assets": {
    "binding": "ASSETS"
  },
  // Replace with your production domain. Used for sitemap generation, canonical
  // URLs, and OG tags. Also exposed to the Worker at runtime as env.BASE_URL.
  "vars": {
    "BASE_URL": "https://example.com"
  }
}
