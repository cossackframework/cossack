{
  "name": "my-cossack-app",
  "type": "module",
  "description": "The Borderless TypeScript Framework",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:ssg": "vite build && cossack ssg",
    "build:all": "pnpm run build && cossack ssg",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "preview": "pnpm run build:ssg && vite preview",
    "deploy": "vite build && cossack ssg && wrangler deploy"
  },
  "dependencies": {
    "@cossackframework/auth": "^0.5.0",
    "@cossackframework/core": "^0.7.0",
    "@cossackframework/database": "^0.1.0",
    "@cossackframework/framework": "^0.7.0",
    "@cossackframework/renderer": "^0.7.0",
    "@cossackframework/solar-icons": "^0.7.0",
    "@cossackframework/ui": "^0.1.0",
    "cossack": "^0.1.0",
    "gray-matter": "^4.0.3",
    "hono": "^4.12.31",
    "marked": "^17.0.1",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.44.0",
    "@tailwindcss/vite": "^4.1.0",
    "prettier": "^3.4.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "wrangler": "^4.110.0"
  }
}
