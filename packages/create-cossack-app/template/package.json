    "hono": "^4.9.5",
    "marked": "^17.0.1",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.37.1",
    "@cloudflare/workers-types": "^4.20260515.1",
    "@tailwindcss/vite": "^4.1.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.7.0",
    "typescript": "^5.0.0",
    "vite": "^8.0.0",
    "wrangler": "^4.92.0"
