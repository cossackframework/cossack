{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cossack",
  "compatibility_date": "2025-08-03",
  "build": {
    "command": "vite build --config vite.client.config.ts && vite build --config vite.ssr.config.ts",
    "watch_dir": ["src", "src/pages"]
  },
  "main": "dist/worker/index.js",
  "durable_objects": {
    "bindings": [
      { "name": "COSSACK_OBJECT", "class_name": "AppDurableObject" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": [
        "AppDurableObject"
      ]
    }
  ],
  "assets": {
    "directory": "./dist/ssg-static",
    "binding": "ASSETS"
  },
  "vars": {
    "R2_ACCOUNT_ID": "2aa2bfe713ea4ef2c4548cf1f658aed7",
    "R2_ACCESS_KEY_ID": "798a126f26e3d2e40a826cf6403afd31",
    "R2_SECRET_ACCESS_KEY": "010788461c2d64eb921d631ac4c69414ddbb852821e016d853ec87f8714f1e9d",
    "R2_ACCOUNT_API_TOKEN": "kr62M5tudIRqs8jIU3Z2BU4vc6OMVq273W4BbAiV",
    "R2_BUCKET_NAME": "serverdash",
    "R2_PUBLIC_URL": "https://data.serverdash.org"
  }
}