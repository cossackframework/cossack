{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cossack",
  "compatibility_date": "2025-08-03",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/index.ts",
  "durable_objects": {
    "bindings": [
      { "name": "COSSACK_OBJECT", "class_name": "AppDurableObject" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": [
        "AppDurableObject"
      ]
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "secrets": { "required": ["APP_SECRET", "R2_ACCESS_KEY_ID", "R2_SECRET_ACCESS_KEY"] },
  "vars": {
    "R2_ACCOUNT_ID": "2aa2bfe713ea4ef2c4548cf1f658aed7",
    "R2_BUCKET_NAME": "serverdash",
    "R2_PUBLIC_URL": "https://data.serverdash.org",
    "APP_URL": "https://cossack.dev",
    // Default locale for localization (`__('key')`). Override per-request via
    // the `cossack_locale` cookie or Accept-Language (when autoDetectBrowser
    // is enabled in createApp({ i18n: { ... } })). Defaults to "en" in code.
    "APP_LOCALE": "en",
  }
}
