{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cossack",
  "compatibility_date": "2025-08-03",
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  "main": "./src/index.ts",
  "durable_objects": {
    "bindings": [
      { "name": "COSSACK_OBJECT", "class_name": "AppDurableObject" },
      { "name": "COSSACK_SSE", "class_name": "SseDurableObject" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": [
        "AppDurableObject"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "SseDurableObject"
      ]
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "secrets": { "required": ["APP_SECRET"] },
  "vars": {
    "APP_URL": "https://cossack.dev",
    // Default locale for localization (`__('key')`). Override per-request via
    // the `cossack_locale` cookie or Accept-Language (when autoDetectBrowser
    // is enabled in createApp({ i18n: { ... } })). Defaults to "en" in code.
    "APP_LOCALE": "en",
  }
}
