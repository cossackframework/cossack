{
  "name": "@cossackframework/framework",
  "version": "0.0.1",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client/index.ts",
    "./vite-plugin": "./src/vite-plugin.ts",
    "./vite-security-plugin": "./src/vite-security-plugin.ts"
  },
  "scripts": {
    "dev": "tsx scripts/build-ssg.ts && node scripts/dev.js",
    "build": "vite build --config vite.client.config.ts --mode production && vite build --config vite.ssr.config.ts --mode ssr --ssr",
    "build:ssg": "tsx scripts/build-ssg.ts",
    "build:all": "pnpm run build && pnpm run build:ssg",
    "serve": "tsx scripts/build-ssg.ts && wrangler dev --local",
    "deploy": "pnpm run build && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.964.0",
    "@aws-sdk/s3-request-presigner": "^3.964.0",
    "@cossackframework/auth": "workspace:*",
    "@cossackframework/core": "workspace:*",
    "@cossackframework/renderer": "workspace:*",
    "@mdx-js/mdx": "^3.1.1",
    "gray-matter": "^4.0.3",
    "hono": "^4.9.5",
    "marked": "^17.0.1",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251004.0",
    "@playwright/test": "^1.40.0",
    "vite": "^5.0.0",
    "vitest": "^1.2.2",
    "wrangler": "^4.0.0"
  }
}