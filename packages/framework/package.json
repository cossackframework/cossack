{
  "name": "@cossackframework/framework",
  "version": "0.7.4",
  "type": "module",
  "description": "Meta framework package for the Cossack Framework",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cossackframework/cossack",
    "directory": "packages/framework"
  },
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js"
    },
    "./config": {
      "types": "./dist/esm/config.d.ts",
      "import": "./dist/esm/config.js"
    },
    "./cache": {
      "types": "./dist/esm/cache.d.ts",
      "import": "./dist/esm/cache.js"
    },
    "./client": {
      "types": "./dist/esm/client/index.d.ts",
      "import": "./dist/esm/client/index.js"
    },
    "./client/app": {
      "types": "./dist/esm/client/app.d.ts",
      "import": "./dist/esm/client/app.js"
    },
    "./blocks": {
      "types": "./dist/esm/blocks/index.d.ts",
      "import": "./dist/esm/blocks/index.js"
    },
    "./vite-plugin": {
      "types": "./dist/esm/vite-plugin.d.ts",
      "import": "./dist/esm/vite-plugin.js"
    },
    "./vite-security-plugin": {
      "types": "./dist/esm/vite-security-plugin.d.ts",
      "import": "./dist/esm/vite-security-plugin.js"
    },
    "./vite-ssg-plugin": {
      "types": "./dist/esm/vite-ssg-plugin.d.ts",
      "import": "./dist/esm/vite-ssg-plugin.js"
    },
    "./router": {
      "types": "./dist/esm/router.d.ts",
      "import": "./dist/esm/router.js"
    },
    "./root": {
      "types": "./dist/esm/root.d.ts",
      "import": "./dist/esm/root.js"
    },
    "./api-handler": {
      "types": "./dist/esm/api-handler.d.ts",
      "import": "./dist/esm/api-handler.js"
    },
    "./cors": {
      "types": "./dist/esm/middlewares/cors.d.ts",
      "import": "./dist/esm/middlewares/cors.js"
    },
    "./ssg-renderer": {
      "types": "./dist/esm/ssg-renderer.d.ts",
      "import": "./dist/esm/ssg-renderer.js"
    },
    "./sitemap-generator": {
      "types": "./dist/esm/sitemap-generator.d.ts",
      "import": "./dist/esm/sitemap-generator.js"
    },
    "./ssg-config": {
      "types": "./dist/esm/ssg-config.d.ts",
      "import": "./dist/esm/ssg-config.js"
    },
    "./route-ids": {
      "types": "./dist/esm/route-ids.d.ts",
      "import": "./dist/esm/route-ids.js"
    },
    "./scroll-reveal": {
      "types": "./dist/esm/client/scroll-reveal.d.ts",
      "import": "./dist/esm/client/scroll-reveal.js"
    },
    "./DurableObject": {
      "types": "./dist/esm/DurableObject.d.ts",
      "import": "./dist/esm/DurableObject.js"
    },
    "./vite-env": "./src/vite-env.d.ts"
  },
  "files": [
    "dist/esm",
    "src/vite-env.d.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "pnpm run build:types && vite build",
    "build:types": "node -e \"require('node:fs').rmSync('dist/esm',{recursive:true,force:true})\" && tsc -p tsconfig.declarations.json",
    "build:ssg": "pnpm run build:types && vite build",
    "build:all": "pnpm run build:types && pnpm run build",
    "preview": "pnpm run build:ssg && vite preview",
    "deploy": "pnpm run build:types && vite build && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "pretest": "pnpm run build:types",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ssg": "COSSACK_TEST_SSG=1 playwright test e2e/pages/ssg.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1075.0",
    "@aws-sdk/s3-request-presigner": "^3.1075.0",
    "@cossackframework/core": "workspace:*",
    "@cossackframework/renderer": "workspace:*",
    "@cossackframework/solar-icons": "^0.7.1",
    "@cossackframework/ui": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-sugar-high": "^0.6.3",
    "remark-toc": "^9.0.0",
    "tsx": "^4.23.0",
    "unified": "^11.0.5",
    "vfile-matter": "^5.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.47.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/mdast": "^4.0.4",
    "cossack": "workspace:*",
    "hono": "^4.12.31",
    "tailwindcss": "^4.1.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  },
  "peerDependencies": {
    "hono": "^4.12.0"
  },
  "engines": {
    "node": ">=22"
  }
}
