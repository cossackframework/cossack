  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "pnpm run build:types && vite build",
    "build:types": "node -e \"require('node:fs').mkdirSync('.cossack',{recursive:true})\" && wrangler types .cossack/library-worker-configuration.d.ts --config wrangler.library.jsonc --env-interface CloudflareBindings && node scripts/build-declarations.mjs",
    "build:ssg": "pnpm run build:types && vite build",
    "build:all": "pnpm run build:types && pnpm run build",
    "preview": "pnpm run build:ssg && vite preview",
    "deploy": "pnpm run build:types && vite build && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "pretest": "pnpm run build:types",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:dev": "COSSACK_E2E_SERVER=dev playwright test",
    "test:e2e:ssg": "COSSACK_TEST_SSG=1 playwright test e2e/pages/ssg.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug"
  },
