{
  "name": "@cossackframework/framework",
  "version": "0.0.1",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client/index.ts",
    "./vite-plugin": "./src/vite-plugin.ts"
  },
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./vite-plugin": "./src/vite-plugin.ts"
  },
  "scripts": {
    "dev": "wrangler dev",
    "build": "vite build --mode production && vite build --mode ssr --ssr",
    "deploy": "pnpm run build && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "test": "vitest"
  },
  "dependencies": {
    "@cossackframework/auth": "workspace:*",
    "@cossackframework/core": "workspace:*",
    "@cossackframework/renderer": "workspace:*",
    "hono": "^4.9.5",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251004.0",
    "vite": "^5.0.0",
    "vitest": "^1.2.2",
    "wrangler": "^4.0.0"
  }
}