{
  "name": "@cossackframework/framework",
  "version": "0.3.2",
  "type": "module",
  "description": "Meta framework package for the Cossack Framework",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cossackframework/cossack",
    "directory": "packages/framework"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./src/index.ts"
    },
    "./client": {
      "types": "./dist/types/client/index.d.ts",
      "import": "./src/client/index.ts"
    },
    "./client/app": {
      "types": "./dist/types/client/app.d.ts",
      "import": "./src/client/app.ts"
    },
    "./vite-plugin": {
      "types": "./dist/types/vite-plugin.d.ts",
      "import": "./dist/plugins/vite-plugin.js"
    },
    "./vite-security-plugin": {
      "types": "./dist/types/vite-security-plugin.d.ts",
      "import": "./dist/plugins/vite-security-plugin.js"
    },
    "./router": {
      "types": "./dist/types/router.d.ts",
      "import": "./src/router.ts"
    },
    "./root": {
      "types": "./dist/types/root.d.ts",
      "import": "./src/root.ts"
    },
    "./api-handler": {
      "types": "./dist/types/api-handler.d.ts",
      "import": "./src/api-handler.ts"
    },
    "./ssg-renderer": {
      "types": "./dist/types/ssg-renderer.d.ts",
      "import": "./src/ssg-renderer.ts"
    },
    "./sitemap-generator": {
      "types": "./dist/types/sitemap-generator.d.ts",
      "import": "./src/sitemap-generator.ts"
    },
    "./DurableObject": {
      "types": "./dist/types/DurableObject.d.ts",
      "import": "./src/DurableObject.ts"
    },
    "./vite-env": "./src/vite-env.d.ts"
  },
  "files": [
    "src",
    "dist/types",
    "dist/plugins"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "vite build --config vite.client.config.ts --mode production && vite build --config vite.ssr.config.ts --mode ssr --ssr",
    "build:ssg": "vite build --config vite.client.config.ts && tsx scripts/build-ssg.ts",
    "build:types": "tsc -p tsconfig.declarations.json && tsc -p tsconfig.plugins.json",
    "build:all": "pnpm run build && pnpm run build:ssg",
    "serve": "wrangler dev --local",
    "deploy": "pnpm run build && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.964.0",
    "@aws-sdk/s3-request-presigner": "^3.964.0",
    "@cossackframework/auth": "workspace:*",
    "@cossackframework/core": "workspace:*",
    "@cossackframework/renderer": "workspace:*",
    "@mdx-js/mdx": "^3.1.1",
    "gray-matter": "^4.0.3",
    "hono": "^4.9.5",
    "marked": "^17.0.1",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251004.0",
    "@playwright/test": "^1.40.0",
    "tsx": "^4.7.0",
    "vite": "^5.0.0",
    "vitest": "^1.2.2",
    "wrangler": "^4.0.0"
  }
}