{
  "name": "@cossackframework/framework",
  "version": "0.4.1",
  "type": "module",
  "description": "Meta framework package for the Cossack Framework",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cossackframework/cossack",
    "directory": "packages/framework"
  },
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js"
    },
    "./client": {
      "types": "./dist/esm/client/index.d.ts",
      "import": "./dist/esm/client/index.js"
    },
    "./client/app": {
      "types": "./dist/esm/client/app.d.ts",
      "import": "./dist/esm/client/app.js"
    },
    "./vite-plugin": {
      "types": "./dist/esm/vite-plugin.d.ts",
      "import": "./dist/esm/vite-plugin.js"
    },
    "./vite-security-plugin": {
      "types": "./dist/esm/vite-security-plugin.d.ts",
      "import": "./dist/esm/vite-security-plugin.js"
    },
    "./router": {
      "types": "./dist/esm/router.d.ts",
      "import": "./dist/esm/router.js"
    },
    "./root": {
      "types": "./dist/esm/root.d.ts",
      "import": "./dist/esm/root.js"
    },
    "./api-handler": {
      "types": "./dist/esm/api-handler.d.ts",
      "import": "./dist/esm/api-handler.js"
    },
    "./ssg-renderer": {
      "types": "./dist/esm/ssg-renderer.d.ts",
      "import": "./dist/esm/ssg-renderer.js"
    },
    "./sitemap-generator": {
      "types": "./dist/esm/sitemap-generator.d.ts",
      "import": "./dist/esm/sitemap-generator.js"
    },
    "./DurableObject": {
      "types": "./dist/esm/DurableObject.d.ts",
      "import": "./dist/esm/DurableObject.js"
    },
    "./vite-env": "./src/vite-env.d.ts"
  },
  "files": [
    "dist/esm",
    "src/vite-env.d.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:ssg": "vite build && tsx scripts/build-ssg.ts",
    "build:types": "tsc -p tsconfig.declarations.json",
    "build:all": "pnpm run build && pnpm run build:ssg",
    "preview": "vite build && vite preview",
    "deploy": "vite build && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.964.0",
    "@aws-sdk/s3-request-presigner": "^3.964.0",
    "@cossackframework/auth": "workspace:*",
    "@cossackframework/core": "workspace:*",
    "@cossackframework/renderer": "workspace:*",
    "@mdx-js/mdx": "^3.1.1",
    "gray-matter": "^4.0.3",
    "hono": "^4.9.5",
    "marked": "^17.0.1",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.37.1",
    "@cloudflare/workers-types": "^4.20260518.1",
    "@playwright/test": "^1.40.0",
    "@tailwindcss/vite": "^4.1.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.7.0",
    "vite": "^8.0.0",
    "vitest": "^3.2.4",
    "workerd": "^1.20260515.1",
    "wrangler": "^4.92.0"
  },
  "engines": {
    "node": ">=22"
  }
}