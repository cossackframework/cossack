{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "declaration": true,
    "outDir": "dist/esm",
    "rootDir": "src"
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "worker-configuration.d.ts"],
  "exclude": ["src/pages/**", "src/components/**"]
}
