{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "declaration": true,
    // Framework components are precompiled and do not use reflected method
    // parameter types. Leaving this enabled turns DOM-only TypeScript types
    // such as KeyboardEvent into eager runtime references during SSR imports.
    // Consumer applications keep emitDecoratorMetadata enabled for constructor
    // injection into their own pages and services.
    "emitDecoratorMetadata": false,
    "types": ["reflect-metadata", "./.cossack/library-worker-configuration.d.ts"],
    "outDir": "dist/esm",
    "rootDir": "src"
  },
  "include": [
    "src/jobs/d1-store.ts",
    "src/markdown-processor.ts",
    "src/api-handler.ts",
    "src/api.ts",
    "src/cache.ts",
    "src/client/devtools.ts",
    "src/client/development-trace-bridge.ts",
    "src/development-traces.ts",
    "src/client/index.ts",
    "src/config.ts",
    "src/config-inspection.ts",
    "src/config-preflight.ts",
    "src/build-budgets.ts",
    "src/budget-receipts.ts",
    "src/deployment-artifact.ts",
    "src/config-requirements.ts",
    "src/DurableObject.ts",
    "src/SseDurableObject.ts",
    "src/middlewares/cors.ts",
    "src/public.ts",
    "src/root.ts",
    "src/route-ids.ts",
    "src/page-inspection.ts",
    "src/runtime-capabilities.ts",
    "src/storage-capabilities.ts",
    "src/session.ts",
    "src/router.ts",
    "src/sitemap-generator.ts",
    "src/ssg-config.ts",
    "src/ssg-entry.ts",
    "src/ssg-renderer.ts",
    "src/vite-plugin.ts",
    "src/vite-security-plugin.ts",
    "src/vite-ssg-plugin.ts",
    "src/vite-env.d.ts",
    ".cossack/library-worker-configuration.d.ts"
  ],
  "exclude": [
    "src/App.ts",
    "src/bootstrap/**",
    "src/components/**",
    "src/demo-catalog.ts",
    "src/examples/**",
    "src/index.ts",
    "src/lang/**",
    "src/models/**",
    "src/pages/**",
    "src/services/**",
    "src/storage/**"
  ]
}
