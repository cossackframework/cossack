{
  "name": "@cossackframework/deno-adapter",
  "version": "0.8.3",
  "type": "module",
  "description": "Deno and Deno Deploy runtime adapter for Cossack",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cossackframework/cossack",
    "directory": "packages/deno-adapter"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && vite build && tsc -p tsconfig.declarations.json",
    "test": "vitest --run"
  },
  "dependencies": {
    "@cossackframework/core": "workspace:*",
    "http-proxy-3": "^1.23.3"
  },
  "peerDependencies": {
    "hono": "^4.13.7",
    "vite": "^8.1.4"
  },
  "devDependencies": {
    "@types/deno": "^2.7.0",
    "hono": "^4.13.7",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.11"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
