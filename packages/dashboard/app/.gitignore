# The served sources (the sign-in pages, the dashboard and their modules) are tracked here: this
# package is their home. The rest of this development application is written by `pnpm sync`.
/*
!/.gitignore
!/.npmignore
!/README.md
!/package.json
!/scripts/
/scripts/*
!/scripts/sync.mjs
!/src/
/src/*
!/src/auth.ts
!/src/auth-options.ts
!/src/auth-providers.ts
!/src/auth-input.ts
!/src/auth-bot-check.ts
!/src/auth-bot-token.ts
!/src/brand.ts
!/src/passkeys.client.ts
!/src/config/
/src/config/*
!/src/config/auth.ts
!/src/dashboard/
!/src/lib/
/src/lib/*
!/src/lib/permissions.ts
!/src/lib/uuid.ts
!/src/middlewares/
/src/middlewares/*
!/src/middlewares/auth.ts
!/src/services/
/src/services/*
!/src/services/users.ts
!/src/services/roles.ts
!/src/services/rbac.ts
!/src/pages/
/src/pages/*
!/src/pages/auth/
!/src/pages/dashboard/
