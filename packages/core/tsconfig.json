{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "moduleResolution": "Bundler",
    "types": ["vite/client", "@cloudflare/workers-types"],
    "paths": {
      "@/*": ["./src/*"]
    },
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    // Let the build script handle output dirs
    "declaration": true
  },
  "include": ["src"]
}
