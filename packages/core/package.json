{
  "name": "@cossackframework/core",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode production && vite build --mode ssr --ssr",
    "preview": "pnpm run build && vite preview",
    "dev:wrangler": "pnpm run build && wrangler dev",
    "deploy": "pnpm run build && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "test": "vitest"
  },
  "dependencies": {
    "@cossackframework/renderer": "workspace:*",
    "hono": "^4.9.5",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240725.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.11.17",
    "jsdom": "^24.0.0",
    "vite": "^5.0.0",
    "vitest": "^1.2.2",
    "wrangler": "^4.0.0"
  }
}
