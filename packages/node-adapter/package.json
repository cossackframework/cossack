{
  "name": "@cossackframework/node-adapter",
  "version": "0.8.0",
  "type": "module",
  "description": "Node.js runtime adapter for the Cossack Framework",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cossackframework/cossack",
    "directory": "packages/node-adapter"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.declarations.json",
    "test": "vitest --run"
  },
  "dependencies": {
    "@cossackframework/core": "workspace:*",
    "nodemailer": "^9.0.3",
    "ws": ">=8.21.0"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.1",
    "@types/ws": "^8.18.0",
    "hono": "^4.12.31",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "hono": "^4.12.0"
  }
}
