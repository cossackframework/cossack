{
  "name": "@cossackframework/node-adapter",
  "version": "0.9.0",
  "type": "module",
  "description": "Node.js runtime adapter for the Cossack Framework",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cossackframework/cossack",
    "directory": "packages/node-adapter"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./notifications": {
      "types": "./dist/notifications.d.ts",
      "import": "./dist/notifications.js"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "import": "./dist/storage.js"
    }
  },
  "files": [
    "dist",
    "agent-docs.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.declarations.json && node ../../scripts/rewrite-declaration-imports.mjs dist",
    "test": "vitest --run"
  },
  "dependencies": {
    "@cossackframework/core": "workspace:*",
    "nodemailer": "^10.0.6",
    "ws": ">=8.21.0",
    "@hono/node-server": "^2.1.0"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.1",
    "@types/ws": "^8.18.0",
    "hono": "^4.13.7",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "hono": "^4.13.7",
    "vite": "^8.1.4"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
