# Dependencies
**/node_modules
/.pnpm-store
# A pnpm workspace has exactly one lockfile at the root.
# Sub-package lockfiles are created accidentally (e.g. running `pnpm install`
# inside a package directory) and must not be tracked.
packages/*/pnpm-lock.yaml

# Build artifacts
**/dist
**/build
**/out

# TypeScript incremental build cache
**/*.tsbuildinfo
/packages/framework/.cossack/library-worker-configuration.d.ts

# Cloudflare Wrangler
.wrangler/
.dev.vars

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDEs and editors
.idea
*.swp
*.swo
test-results
.last-run.json
.claude
reasonix.toml
.reasonix
.zcode
# Planning documents (local scratch)
plan-*.md
reviews.md
request-update.md
todo.md

