{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@cossackframework/*": ["./packages/*/src"]
    }
  },
  "files": [],
  "references": [
    { "path": "./packages/core" },
    { "path": "./packages/renderer" },
    { "path": "./packages/database" },
    { "path": "./packages/node-adapter" },
    { "path": "./packages/test-utils" },
    { "path": "./packages/ui" },
    { "path": "./packages/framework" }
  ]
}
