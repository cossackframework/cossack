{
  "name": "@cossackframework/example-desktop-counter",
  "version": "0.1.0",
  "description": "Cossack Framework Electron Desktop counter example",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <26"
  },
  "main": "dist/desktop/index.js",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && vite build --ssr src/index.ts --outDir dist/server",
    "start": "node dist/server/index.js",
    "build:desktop": "vite build && vite build --mode desktop --ssr src/desktop/index.ts --outDir dist/desktop --minify false",
    "desktop:dev": "cossack-desktop",
    "desktop:package": "pnpm run build:desktop && electron-forge package",
    "desktop:make": "pnpm run build:desktop && electron-forge make",
    "desktop:build": "pnpm run desktop:make"
  },
  "dependencies": {
    "@cossackframework/core": "workspace:*",
    "@cossackframework/desktop": "workspace:*",
    "@cossackframework/framework": "workspace:*",
    "@cossackframework/renderer": "workspace:*",
    "@cossackframework/ui": "workspace:*",
    "@cossackframework/node-adapter": "workspace:*",
    "@hono/node-server": "^1.13.0",
    "@tailwindcss/vite": "^4.1.0",
    "hono": "^4.12.31",
    "tailwindcss": "^4.1.0",
    "vite": "^8.1.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-wix": "^7.11.2",
    "@electron-forge/shared-types": "^7.11.2",
    "@types/node": "^22.19.0",
    "@types/ws": "^8.18.0",
    "electron": "^43.3.0",
    "typescript": "^7.0.2"
  }
}
