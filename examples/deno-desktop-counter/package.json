{
  "name": "@cossackframework/example-deno-desktop-counter",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && vite build --ssr src/index.ts --outDir dist/server",
    "start": "deno run --allow-env --allow-net --allow-read dist/server/index.js",
    "desktop:dev": "deno desktop --hmr .",
    "desktop:build": "deno task build && deno desktop ."
  },
  "dependencies": {
    "@cossackframework/core": "workspace:*",
    "@cossackframework/deno-adapter": "workspace:*",
    "@cossackframework/framework": "workspace:*",
    "@cossackframework/renderer": "workspace:*",
    "@cossackframework/ui": "workspace:*",
    "@tailwindcss/vite": "^4.1.0",
    "hono": "^4.12.31",
    "tailwindcss": "^4.1.0",
    "vite": "^8.1.4"
  },
  "devDependencies": {
    "@types/deno": "^2.3.0",
    "@types/node": "^22.19.0",
    "typescript": "^7.0.2"
  }
}
