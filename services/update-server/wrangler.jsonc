{
  // The update server of the Cossack CMS (specs/cms-updates.md). It serves one small JSON answer
  // from the release list bundled with it, and keeps no record of any request.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cossack-update-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-06",
  "workers_dev": false,
  "routes": [{ "pattern": "cms.cossack.dev", "custom_domain": true }],
  // No request logs: the server is not to know which sites ask.
  "observability": { "enabled": false }
}
